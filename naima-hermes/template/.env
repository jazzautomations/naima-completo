# ============================================================
# Naima (Hermes Agent) — variáveis de ambiente
# Instalação pura da imersão "Agente IA na Prática"
#
# Este arquivo fica em /root/.hermes/.env na sua VPS,
# com permissão 600 (só o root lê). Nunca compartilhe
# o conteúdo dele com ninguém.
# ============================================================

# Token do bot do Telegram, criado no @BotFather.
# O instalador substitui o placeholder pelo seu token real.
TELEGRAM_BOT_TOKEN={{TELEGRAM_BOT_TOKEN}}

# Seu Telegram user ID numérico (pegue no @userinfobot).
# SÓ esse ID consegue conversar com a sua Naima.
# Qualquer outra pessoa que mandar mensagem é ignorada.
TELEGRAM_ALLOWED_USERS={{DONO_TELEGRAM_ID}}

# A Naima reage com emoji nas suas mensagens (confirmação visual).
TELEGRAM_REACTIONS=true

# Não precisa de chave de API de LLM aqui: a inteligência
# entra via OAuth da sua conta ChatGPT (device flow),
# que o instalador configura na Etapa 4.
